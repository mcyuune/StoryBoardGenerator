@page
@model IndexModel
@{
    ViewData["Title"] = "New story";
}

<h1>Turn a story into a board</h1>
<p class="lede">Paste text. The app splits it into scenes, stores a picture for each one, and shows them in order.</p>

<form method="post">
    <label asp-for="Title"></label>
    <input asp-for="Title" />
    <span asp-validation-for="Title"></span>

    <label asp-for="SourceText"></label>
    <textarea asp-for="SourceText" rows="12" placeholder="Paste a short story. Blank lines become separate scenes."></textarea>
    <span asp-validation-for="SourceText"></span>

    <button type="submit">Generate storyboard</button>
</form>
