@page "{id:int}"
@model StoryBoardGenerator.Pages.Stories.DetailsModel
@{
    ViewData["Title"] = Model.Story!.Title;
}

<h1>@Model.Story.Title</h1>
<p class="lede">@Model.Story.Scenes.Count scene(s)</p>

<ol class="board">
    @foreach (var scene in Model.Story.Scenes)
    {
        <li>
            <img src="@scene.ImagePath" alt="Scene @scene.Sequence" />
            <p><strong>@scene.Sequence.</strong> @scene.Caption</p>
        </li>
    }
</ol>
